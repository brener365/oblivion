generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  STARTER
  GROWTH
  SCALE
}

enum UserRole {
  OWNER
  ADMIN
  ANALYST
  OPERATOR
}

model Tenant {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  planTier         PlanTier            @default(STARTER)
  stripeCustomerId String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  users            User[]
  products         Product[]
  suppliers        Supplier[]
  salesSnapshots   SalesSnapshot[]
  alerts           Alert[]
  automationRules  AutomationRule[]
  auditLogs        AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String
  role         UserRole @default(ANALYST)
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

model Supplier {
  id                 String   @id @default(cuid())
  tenantId           String
  source             String
  externalId         String
  name               String
  country            String?
  moq                Int?
  rating             Float?
  leadTimeDays       Int?
  certifications     String[]
  trustScore         Float?
  trustScoreMetadata Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products           Product[]

  @@unique([tenantId, source, externalId])
}

model Product {
  id                   String   @id @default(cuid())
  tenantId             String
  supplierId           String?
  sku                  String
  name                 String
  category             String?
  costPrice            Decimal  @db.Decimal(12, 2)
  shippingCost         Decimal  @db.Decimal(12, 2)
  taxesEstimate        Decimal  @db.Decimal(12, 2)
  marketplaceFee       Decimal  @db.Decimal(12, 2)
  suggestedSalePrice   Decimal? @db.Decimal(12, 2)
  estimatedMargin      Float?
  viralScore           Float?
  trendMomentum        Float?
  saturationRisk       Float?
  profitPotential      Float?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier             Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sku])
}

model SalesSnapshot {
  id             String   @id @default(cuid())
  tenantId       String
  channel        String
  snapshotDate   DateTime
  grossRevenue   Decimal  @db.Decimal(14, 2)
  netRevenue     Decimal  @db.Decimal(14, 2)
  orders         Int
  adSpend        Decimal  @db.Decimal(14, 2)
  sourceMetadata Json?
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, snapshotDate])
}

model Alert {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  severity    String
  title       String
  description String
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AutomationRule {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  triggerType String
  actionType  String
  isActive    Boolean  @default(true)
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String
  payload    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
